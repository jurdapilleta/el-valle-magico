{
  "name": "el-valle-magico",
  "version": "0.1.0",
  "description": "El Valle Mágico",
  "scripts": {
    "test": "vitest run",
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc",
    "test:e2e": "playwright test",
    "assets": "node tools/assets/build.mjs",
    "audio": "vite-node tools/audio/build.ts",
    "audio:check": "vite-node tools/audio/build.ts -- --check",
    "audio:script": "vite-node tools/audio/script.ts",
    "audio:hosts": "vite-node tools/audio/generate_hosts.ts",
    "audio:placeholders": "python3 tools/audio/make_sfx.py && python3 tools/audio/make_music.py",
    "icons": "node tools/assets/make_icons.mjs"
  },
  "type": "module",
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "howler": "^2.2.4",
    "idb-keyval": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "three-pathfinding": "^1.3.0",
    "xstate": "^5.33.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gltf-transform/core": "^4.5.1",
    "@playwright/test": "^1.65.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "r3f-perf": "^7.2.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9"
  },
  "private": true
}
